# ── Backend ───────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 5000)
PORT=5000

# Node environment: development | production
NODE_ENV=development

# ── Frontend (React build-time only) ──────────────────────────────────────────
# If running frontend separately without the proxy, set the API base URL.
# Leave blank when using the CRA proxy (local dev) or nginx proxy (Docker).
# REACT_APP_API_BASE_URL=http://127.0.0.1:5000

# ── Notes ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values. Never commit .env to source control.
# No secrets are required — this application performs local file analysis only.
