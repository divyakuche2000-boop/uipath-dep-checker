*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── OS / editor artifacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Test / coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

